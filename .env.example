# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Neon pooled connection string (Dashboard → Connect → Pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Console → Auth. Cookie secret must be 32+ characters: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32

# FatSecret Platform REST API (optional). OAuth 1.0 consumer key + secret — no IP whitelist.
# Register at https://platform.fatsecret.com/. Server-side only. Do not prefix with NEXT_PUBLIC_.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
