# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Neon pooled connection string (Dashboard → Connect → Pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Console → Auth. Cookie secret must be 32+ characters: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Optional public site origin for canonical URLs, sitemap, and Open Graph.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL if unset.
NEXT_PUBLIC_SITE_URL=https://fitsehat.argorsi.com

# FatSecret Platform REST API (optional). OAuth 1.0 consumer key + secret — no IP whitelist.
# Register at https://platform.fatsecret.com/. Server-side only. Do not prefix FatSecret vars with NEXT_PUBLIC_.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Optional Gemini (FitSehat AI meal logging). Server-side only — never NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey. Missing keys degrade to Search Food.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
